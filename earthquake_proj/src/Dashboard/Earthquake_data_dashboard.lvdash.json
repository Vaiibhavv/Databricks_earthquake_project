{
  "datasets": [
    {
      "name": "5d480dbf",
      "displayName": "Earthquake_data",
      "queryLines": [
        "select * from silver.silver_scd;"
      ],
      "catalog": "earthquake_proj",
      "schema": "silver"
    },
    {
      "name": "abd3a731",
      "displayName": "earthquake_type",
      "queryLines": [
        "select count(*) as total_magnitude_bucket,magnitude_bucket from (select CASE\r\n",
        "        WHEN mag < 2 THEN 'Micro (<2)'\r\n",
        "        WHEN mag BETWEEN 2 AND 3 THEN 'Minor (2–3)'\r\n",
        "        WHEN mag BETWEEN 3 AND 4 THEN 'Light (3–4)'\r\n",
        "        ELSE 'Moderate+ (4+)'\r\n",
        "        END AS magnitude_bucket\r\n",
        "        from silver.silver_scd)\r\n",
        "        group by magnitude_bucket"
      ],
      "catalog": "earthquake_proj",
      "schema": "silver"
    },
    {
      "name": "0abf6d05",
      "displayName": "earthquake_country",
      "queryLines": [
        "SELECT \r\n",
        "    count(*) AS event_count,\r\n",
        "    -- CASE \r\n",
        "    --   WHEN size(split(place, ', ')) = 1 THEN split(place, ', ')[0]\r\n",
        "    --   ELSE split(place, ', ')[1]\r\n",
        "    -- END AS country\r\n",
        "    split(place, ', ')[0] AS country\r\n",
        "FROM (\r\n",
        "    SELECT \r\n",
        "        time,\r\n",
        "        title,\r\n",
        "        mag,\r\n",
        "        longitude,\r\n",
        "        place,\r\n",
        "        latitude\r\n",
        "    FROM silver.silver_scd\r\n",
        ")\r\n",
        "GROUP BY country;"
      ],
      "catalog": "earthquake_proj",
      "schema": "silver"
    }
  ],
